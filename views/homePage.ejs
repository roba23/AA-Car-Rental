<!DOCTYPE html>
<meta lang="en">
<html>
    <head>
        <title>Home Page</title>
        <link  rel="stylesheet" href="/styles/main.css">
        <link rel="stylesheet" href="/styles/card.css">
       
    </head>
    <body>
        <%-include("partial/header.ejs") %>
        <div class="container">
            <div class="sidebar">
                     <div class="filter">
                    <h2>Fiter By</h2>
                    <h3>Type</h3>
                    <div class="entrys">
                        <input type="checkbox"  name="filterType" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=suv'}})(this)"
                        <%= selectedFilter === 'suv' ? 'checked' : '' %>>suv
                    </div>
                    <div class="entrys">
                        <input type="checkbox" name="filterType" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=hatchback'}})(this)"
                        <%= selectedFilter === 'hatchback' ? 'checked' : '' %>>hatchback
                    </div>
                    <div class="entrys">
                        <input type="checkbox"  name="filterType" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=sedan'}})(this)"
                        <%= selectedFilter === 'sedan' ? 'checked' : '' %>>sedan
                    </div>
                    <div class="entrys">
                        <input type="checkbox"  name="filterType" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=pickup'}})(this)"
                        <%= selectedFilter === 'pickup' ? 'checked' : '' %>>Pickup
                    </div>
                    <h3>Price</h3>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=100&filter=1000'}})(this)">$100 - $1,000
                    </div>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=1000&filter=10000'}})(this)">$1,000 - $10,000
                    </div>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=10000&filter=50000'}})(this)">$10,000 - $50,000
                    </div>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=50000&filter=100000'}})(this)">$50,000 - $100,000
                    </div>
                </div>

            </div>
            <div class="mainBody">
                <%# This is bereket pull request %>
                <% if(locals.data){ %>
                 <% data.forEach(data => { %>
                    
                <div class="card" onClick = "window.location.href='/moreDetail/<%=data._id %>'">
                    <small style="position: relative; top: 0; right: 1%; background-color: <%= ( data.orderId && data.orderId.Status ) ? 'green' : 'red' %>; color: white;">
                        <%= ( data.orderId && data.orderId.Status ) ? "Out" : "Available" %> 
                    </small>

                    <h4><%=data.name %></h4>
                    <div class="box-1">
                        <p ><%=data.type%></p>
                        <p class="price">$<%=data.priceMonthly%>/month</p>
                    </div>
                    <img src=<%= data.imgUrl %> alt="car Image">
                    <div class="info">
                        <div class="item">

                        </div>
                    </div>"
                    
                        <p><%=data.description %></p>
                   
                </div>
                <% })} %>
            </div>

        </div>
  
    </body>
</html>
