<!DOCTYPE html>
<meta lang="en">
<html>
    <head>
        <title>Home Page</title>
        <link  rel="stylesheet" href="/styles/main.css">
        <link rel="stylesheet" href="/styles/card.css">
       
    </head>
    <body>
        <%-include("partial/header.ejs") %>
        <div class="container">
             <div class="sidebar">
                <div class="filter">
                    <h2>Filter By</h2>
                    
                    <h3>Car Type</h3>
                    <div class="entrys">
                        <input type="checkbox" name="typeFilter" value="Hatchback">hatchback
                    </div>
                    <div class="etnrys">
                        <input type="checkbox" name="typeFilter" value="Coupe">coupe
                    </div>
                    <div class="entrys">
                        <input type="checkbox" name="typeFilter" value="Convertible">convertible
                    </div>
                    <div class="entrys">
                        <input type="checkbox" name="typeFilter" value="Wagon">wagons
                    </div>
                    <div class="entrys">
                        <input type="checkbox" name="typeFilter" value="Crossover">crossovers
                    </div>
                    <div class="entrys">
                        <input type="checkbox" name="typeFilter" value="Pickup">pickup
                    </div>
                    <h3>Price</h3>
                    <div class="entrys">
                        <input type="checkbox" name="priceFilter" value="[10000,50000]">$10,000 - $50,000
                    </div>
                    <div class="entrys">
                        <input type="checkbox" name="priceFilter" value="[50000, 100000]">$50,000 - $100,000
                    </div>
                </div>
                <div class="filterByPrice">

                </div>
            </div>
            


            <div class="mainBody">
                <%# This is bereket pull request %>
                <% if(locals.data){ %>
                 <%for(let i = 0; i < data.length; i++){ %>
                    
                <div class="card" onClick = "window.location.href='/moreDetail/<%=data[i]._id %>'">
                    <h4><%=data[i].name %></h4>
                    <div class="box-1">
                        <p ><%=data[i].type%></p>
                        <p class="price"><%=data[i].priceMonthly%>$ | <%=data[i].priceYearly%>$</p>
                    </div>
                    <img src=<%=data[i].imgUrl %> alt="car Image">
                    <div class="info">
                        <div class="item">

                        </div>
                    </div>
                    
                        <p><%=data[i].description %></p>
                   
                </div>
                <% }%>
                
                <% } %>
                
            </div>
            <div class="pageNavigation">
                <button>1</button> / <button>2</button>
            </div>

        </div>
  
    </body>
</html>