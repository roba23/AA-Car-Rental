<!DOCTYPE html>
<meta lang="en">
<html>
    <head>
        <title>Home Page</title>
        <link  rel="stylesheet" href="/styles/main.css">
        <link rel="stylesheet" href="/styles/card.css">
       
    </head>
    <body>
        <%-include("partial/header.ejs") %>
        <div class="container">
            <div class="sidebar">
                <div class="filter">
                    <h2>Fiter</h2>
                    <h3>Type</h3>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=suv'}})(this)">suv
                    </div>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=hatchback'}})(this)">hatchback
                    </div>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=sedan'}})(this)">sedan
                    </div>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=pickup'}})(this)">Pickup
                    </div>
                    <h3>Price</h3>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=100&filter=1000'}})(this)">$100 - $1,000
                    </div>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=1000&filter=10000'}})(this)">$1,000 - $10,000
                    </div>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=10000&filter=50000'}})(this)">$10,000 - $50,000
                    </div>
                    <div class="entrys">
                        <input type="checkbox" onchange="((e)=>{if(e.checked){ window.location.href='/?filter=50000&filter=100000'}})(this)">$50,000 - $100,000
                    </div>
                </div>
            </div>
            <div class="mainBody">
                
                <% if(locals.data){ %>
                 <%for(let i = 0; i < data.length; i++){ %>
                    
                <div class="card" onClick = "window.location.href='/moreDetail/<%=data[i]._id %>'">
                    <h4><%=data[i].name %></h4>
                    <div class="box-1">
                        <p ><%=data[i].type%></p>
                        <p class="price"><%=data[i].priceMonthly%>$/Month</p>
                    </div>
                    <img src=<%=data[i].imgUrl %> alt="car Image">
                    <div class="info">
                        <div class="item">

                        </div>
                    </div>"
                    
                        <p><%=data[i].description %></p>
                   
                </div>
                <% }} %>
            </div>

        </div>
  
    </body>
</html>