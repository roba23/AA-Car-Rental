<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');

  :root {
    --ink: #111827;
    --muted: #6b7280;
    --paper: #f7f8fb;
    --line: #e6e8ef;
    --brand: #ff6b35;
    --brand-dark: #e85320;
    --navy: #172554;
    --green: #16856a;
    --danger: #d9485f
  }

  * {
    box-sizing: border-box
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'DM Sans', sans-serif
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: Manrope, sans-serif;
    margin: 0
  }

  a {
    color: inherit;
    text-decoration: none
  }

  button,
  .button {
    border: 0;
    border-radius: 10px;
    background: var(--brand);
    color: #fff;
    cursor: pointer;
    font: 600 .93rem 'DM Sans';
    padding: 12px 18px;
    transition: .2s
  }

  .button:hover,
  button:hover {
    background: var(--brand-dark);
    transform: translateY(-1px)
  }

  input,
  select,
  textarea {
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 11px 12px;
    font: inherit;
    width: 100%;
    background: #fff
  }

  .site-header {
    height: 76px;
    background: rgba(255, 255, 255, .92);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    padding: 0 max(5vw, 28px);
    gap: 34px;
    position: sticky;
    top: 0;
    z-index: 20
  }

  .brand {
    font: 800 1.25rem Manrope;
    color: var(--navy);
    letter-spacing: -.7px
  }

  .brand span {
    color: var(--brand)
  }

  .site-nav {
    display: flex;
    gap: 24px;
    align-items: center;
    flex: 1
  }

  .site-nav a {
    font-size: .9rem;
    color: #4b5563
  }

  .site-nav a:hover {
    color: var(--brand)
  }

  .header-actions {
    display: flex;
    gap: 10px;
    align-items: center
  }

  .header-actions .login {
    padding: 9px 14px;
    color: var(--navy)
  }

  .header-actions .button {
    padding: 10px 15px
  }

  .page {
    max-width: 1220px;
    margin: auto;
    padding: 42px 26px 72px
  }

  .admin-layout {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 28px;
    max-width: 1220px;
    margin: auto;
    padding: 30px 26px 70px
  }

  .admin-sidebar {
    background: #172554;
    color: #fff;
    border-radius: 16px;
    padding: 18px;
    height: max-content;
    position: sticky;
    top: 96px
  }

  .admin-sidebar .side-title {
    font: 700 .75rem Manrope;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: #a5b4fc;
    margin: 4px 10px 15px
  }

  .admin-sidebar a {
    display: block;
    padding: 12px 10px;
    border-radius: 8px;
    color: #dbeafe;
    font-size: .92rem
  }

  .admin-sidebar a:hover {
    background: #253870;
    color: #fff
  }

  .site-footer {
    background: #101936;
    color: #cbd5e1;
    padding: 48px max(5vw, 28px) 22px
  }

  .footer-grid {
    max-width: 1220px;
    margin: auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 28px
  }

  .footer-grid h3 {
    color: #fff;
    font-size: 1rem;
    margin-bottom: 12px
  }

  .footer-grid p,
  .footer-grid a {
    font-size: .87rem;
    color: #aebbd1;
    line-height: 1.7
  }

  .footer-grid a {
    display: block
  }

  .copyright {
    max-width: 1220px;
    margin: 35px auto 0;
    padding-top: 18px;
    border-top: 1px solid #273354;
    font-size: .8rem;
    color: #93a2bd
  }

  .eyebrow {
    color: var(--brand);
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 22px
  }

  .section-head p {
    color: var(--muted);
    margin: 7px 0 0
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(245px, 1fr));
    gap: 20px
  }

  .car-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    transition: .25s
  }

  .car-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 35px #16204416
  }

  .car-card img {
    width: 100%;
    height: 175px;
    object-fit: cover;
    background: #edf0f5
  }

  .card-content {
    padding: 16px
  }

  .status {
    display: inline-flex;
    padding: 4px 8px;
    border-radius: 20px;
    font-size: .7rem;
    font-weight: 700;
    background: #dcfce7;
    color: #166534
  }

  .status.out {
    background: #fee2e2;
    color: #b91c1c
  }

  .car-card h3 {
    font-size: 1rem;
    margin: 10px 0 5px
  }

  .car-meta,
  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted);
    font-size: .82rem
  }

  .price-row {
    margin-top: 15px
  }

  .price-row strong {
    font: 800 1.05rem Manrope;
    color: var(--ink)
  }

  .price-row small {
    font-weight: 400
  }

  .filter-panel {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px
  }

  .filter-panel h3 {
    font-size: 1rem;
    margin-bottom: 16px
  }

  .filter-group {
    border-top: 1px solid var(--line);
    padding: 16px 0 0;
    margin-top: 16px
  }

  .filter-group h4 {
    font-size: .82rem;
    margin-bottom: 10px
  }

  .filter-option {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 0;
    font-size: .88rem;
    color: #4b5563
  }

  .filter-option input {
    width: auto;
    accent-color: var(--brand)
  }

  .browse-layout {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 28px
  }

  .hero {
    background: linear-gradient(115deg, #101b42 0%, #1e3270 62%, #ff7444 160%);
    min-height: 445px;
    overflow: hidden;
    position: relative;
    color: #fff;
    display: flex;
    align-items: center;
    padding: 60px max(7vw, 28px);
    isolation: isolate
  }

  .hero:after {
    content: '';
    position: absolute;
    width: 580px;
    height: 580px;
    border: 1px solid #ffffff31;
    border-radius: 50%;
    right: -95px;
    top: -70px;
    z-index: -1
  }

  .hero-copy {
    max-width: 550px
  }

  .hero h1 {
    font-size: clamp(2.3rem, 5vw, 4.5rem);
    line-height: 1.06;
    letter-spacing: -.06em;
    margin: 12px 0 18px
  }

  .hero p {
    font-size: 1.02rem;
    color: #d7def4;
    line-height: 1.65;
    max-width: 450px;
    margin-bottom: 25px
  }

  .hero .button {
    display: inline-block
  }

  .hero-car {
    position: absolute;
    right: 8%;
    bottom: 22%;
    width: min(42vw, 520px);
    filter: drop-shadow(0 28px 18px #060b2080);
    animation: car-turn 8s ease-in-out infinite
  }

  .orbit {
    position: absolute;
    right: 5%;
    bottom: 8%;
    width: min(44vw, 540px);
    aspect-ratio: 1;
    border: 2px dashed #ffffff38;
    border-radius: 50%;
    animation: spin 18s linear infinite;
    z-index: -1;
    padding-top: 100px;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg)
    }
  }

  @keyframes car-turn {

    0%,
    100% {
      transform: perspective(900px) rotateY(-10deg) translateY(0)
    }

    50% {
      transform: perspective(900px) rotateY(10deg) translateY(-12px)
    }
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 34px
  }

  .detail-photo {
    background: #e9edf3;
    border-radius: 18px;
    min-height: 390px;
    width: 100%;
    object-fit: cover
  }

  .detail-panel,
  .booking-card,
  .form-card,
  .order-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 25px
  }

  .detail-panel h1 {
    font-size: 2rem;
    margin: 7px 0
  }

  .detail-panel>p {
    color: var(--muted);
    line-height: 1.7
  }

  .specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 22px 0
  }

  .spec {
    padding: 12px;
    background: #f7f8fb;
    border-radius: 10px
  }

  .spec small {
    display: block;
    color: var(--muted);
    font-size: .73rem
  }

  .spec strong {
    font-size: .91rem
  }

  .booking-card {
    margin-top: 18px
  }

  .booking-card h3 {
    font-size: 1.1rem;
    margin-bottom: 16px
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px
  }

  .form-field label {
    font-size: .8rem;
    font-weight: 700;
    display: block;
    margin: 0 0 6px
  }

  .form-field.full {
    grid-column: 1/-1
  }

  .form-card {
    max-width: 820px
  }

  .form-card h1 {
    font-size: 1.6rem;
    margin-bottom: 6px
  }

  .form-card>p {
    color: var(--muted);
    margin-top: 0
  }

  .order-list {
    display: grid;
    gap: 16px
  }

  .order-card {
    display: grid;
    grid-template-columns: 150px 1fr auto;
    gap: 20px;
    align-items: center
  }

  .order-card img {
    width: 150px;
    height: 100px;
    object-fit: cover;
    border-radius: 10px;
    background: #edf0f5
  }

  .order-card h3 {
    font-size: 1rem;
    margin-bottom: 8px
  }

  .order-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--muted);
    font-size: .84rem
  }

  .actions {
    display: flex;
    gap: 8px
  }

  .approve {
    background: var(--green)
  }

  .reject {
    background: var(--danger)
  }

  .approved {
    color: var(--green);
    font-weight: 700
  }

  .declined {
    color: var(--danger);
    font-weight: 700
  }

  .auth-page {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1.05fr .95fr
  }

  .auth-intro {
    background: linear-gradient(145deg, #101b42, #293e85);
    color: #fff;
    padding: clamp(40px, 8vw, 110px);
    display: flex;
    flex-direction: column;
    justify-content: center
  }

  .auth-intro h1 {
    font-size: clamp(2.4rem, 4vw, 3.7rem);
    line-height: 1.08
  }

  .auth-intro p {
    color: #c7d2fe;
    line-height: 1.7;
    max-width: 410px
  }

  .auth-form {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 38px
  }

  .auth-form .form-card {
    width: min(100%, 440px)
  }

  .auth-form form {
    display: grid;
    gap: 14px
  }

  .empty {
    background: #fff;
    border: 1px dashed #cbd5e1;
    border-radius: 14px;
    padding: 36px;
    text-align: center;
    color: var(--muted)
  }

  @media(max-width:800px) {
    .site-nav {
      display: none
    }

    .header-actions {
      margin-left: auto
    }

    .browse-layout,
    .detail-grid,
    .admin-layout,
    .auth-page {
      grid-template-columns: 1fr
    }

    .admin-sidebar {
      position: static;
      display: flex;
      gap: 4px;
      overflow: auto
    }

    .admin-sidebar .side-title {
      display: none
    }

    .admin-sidebar a {
      white-space: nowrap
    }

    .hero {
      min-height: 500px;
      padding-top: 45px;
      z-index: 100;
      align-items: start
    }
    .hero img{
      
     z-index: -1;
    }

    .hero-car {
      width: 78vw;
      
      right: 8%;
      bottom: 8%;
     
    }

    .orbit {
      width: 83vw;
      right: 4%;
      bottom: 1%
    }

    .footer-grid {
      grid-template-columns: 1fr
    }

    .order-card {
      grid-template-columns: 1fr
    }

    .order-card img {
      width: 100%;
      height: 180px
    }

    .form-grid {
      grid-template-columns: 1fr
    }

    .form-field.full {
      grid-column: auto
    }
  }
</style>
<header class="site-header">
  <a class="brand" href="/">Road<span>Ready</span></a>
  <nav class="site-nav" aria-label="Primary navigation">
      <a href="/">Explore cars</a>
      <a href="/#how-it-works">How it works</a>
      

    <% if (locals.role && role === 'admin') { %>
         <a href="/orderHistory">My bookings</a>
        <a href="/orders">Dashboard</a>
    <% } %>
    
  </nav>

  <div class="header-actions">

    <% if(locals.user && user.fullname){ %>
      <p> 
          <span id="greeting" data-username="<%= user.fullname.charAt(0).toUpperCase() + user.fullname.slice(1) %>"></span>.
      </p>
    <% }  %>

    <% if(locals.role){ %>
      <a class="login" href="/user/logout">Log Out</a>
    <% } else{%>
    <a class="login" href="/user/login">Log in</a>
    <% } %>

  </div>
</header>