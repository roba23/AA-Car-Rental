<!DOCTYPE html>
<html>
    <head>
        <title>Admin</title>
        <link rel="stylesheet" href="/styles/main.css">
        <link rel="stylesheet" href="/styles/form.css">
        <link rel="stylesheet" href="/styles/order.css">
    </head>
    <body>
        <%-include("partial/header.ejs") %>
    <div class="container">
       <%-include ("partial/sidebar.ejs") %>
        <div class="mainBody">
            <% orders.forEach(order=> {  %>
        <div class="order_card">
            <% if(order.carId) {  %>
            <img style="max-width: 150px;" src="<%= order.carId.imgUrl %>" alt="">
            <h2><%= order.carId.name %></h2>
            <p> Model: <%= order.carId.model %></p>
            <%   } else { %>
            <p>Car information missing or deleted</p>
            <%   }  %>
            <div>
            <p> Renter Name : <%=order.fullname %> </p>
            <p> Renter Phone : <%= order.phone%> </p>
            <p>Pick Up Date :  <%= order.pickUp ? new Date(order.pickUp).toDateString() : 'N/A' %> </p>
            <p> Drop Off Date : <%= order.dropOff ? new Date(order.dropOff).toDateString() : 'N/A' %> </p>
            <span> Bank Receipt:
            <a href="<%=order.receipt %>">Receipt</a>
            </span>

            <form action="/order/<%=order._id%>?_method=PUT" method="POST">
                <% if(!order.status){ %>
                    <button style="background-color: green; color: white;padding: 3px 2%;" type="submit">Accept</button>
                <% } else{ %>
                    <p style="color: yellowgreen;"> 
                        <i style="color: green;" class="fa-solid fa-check-double"></i>
                        Approved </p>
                <% } %>
            </form>
            
            </div>
        </div>
        
        <hr>
  <%  }) %>
        </div>
    
    </div>
   


</body>
</html>