<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" 
    integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" 
    crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>

    <header>
        <nav style="display: flex; align-items: center;">
            <a style="margin: 5% auto; text-align: center;" href="/"> Home </a>
        </nav>
    </header>
   <% orders.forEach(order=> {  %>
        <div>
            <% if(order.carId) {  %>
            <span>Car 👉:
                <img style="max-width: 150px;" src="<%= order.carId.imageUrl %>" alt="">
            </span>
            <p>Type 👉: <%= order.carId.carName %></p>
            <p> Model 👉: <%= order.carId.Model %></p>
        <%   } else { %>
            <p>Car information missing or deleted</p>
        <%   }  %>

        </div>
        <div>
            <p> Renter Full Name 👉: <%=order.renterName %> </p>
            <p> Renter Phone 👉: <%= order.Phone%> </p>
            <p>Pick Up Date 👉:  <%= order.pickUp ? new Date(order.pickUp).toDateString() : 'N/A' %> </p>
            <p> Drop Off Date 👉: <%= order.dropOFF ? new Date(order.dropOFF).toDateString() : 'N/A' %> </p>
            <span> Bank Receipt 👉: 
                <img src=" <%= order.Receipt %> " alt="" style="max-width: 200px;">
            </span>

            <form action="/order/<%=order._id%>?_method=PUT" method="POST">
                <% if(!order.Status){ %>
                    <button style="background-color: green; color: white;padding: 3px 2%;" type="submit">Accept</button>
                <% } else{ %>
                    <p style="color: yellowgreen;"> 
                        <i style="color: green;" class="fa-solid fa-check-double"></i>
                        Approved </p>
                <% } %>
            </form>
            
        </div>
        <hr>
  <%  }) %>


</body>
</html>